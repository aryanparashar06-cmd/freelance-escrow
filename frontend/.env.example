# Local Hardhat defaults. Copy this file to `.env.local` and change values per environment.
VITE_ESCROW_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
VITE_CHAIN_ID=31337
VITE_NETWORK_NAME=Hardhat Localhost

# GitHub Pages repository path. Use `/` for a custom domain or root-hosted build.
VITE_BASE_PATH=/freelance-escrow/

# Sepolia example (set the deployed address before building):
# VITE_ESCROW_ADDRESS=0xYourSepoliaContractAddress
# VITE_CHAIN_ID=11155111
# VITE_NETWORK_NAME=Sepolia
